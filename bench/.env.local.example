# Benchmark database connection. Copy to .env.local and customize.
# Values below match the Postgres in the repository-root docker-compose.yml,
# published on 5433. Real shell environment variables win over this file.
#
# Both databases are created by `mix bench.setup`.

SCRIBA_BENCH_DB_HOST=localhost
SCRIBA_BENCH_DB_PORT=5433
SCRIBA_BENCH_DB_USER=postgres
SCRIBA_BENCH_DB_PASS=postgres
