# Template for .env.local — committed to the repo, no real secrets.
#
# Copy to .env.local (gitignored) and fill in real values. config/test.exs
# auto-loads .env.local at config-load time. Real shell environment
# variables still win over .env.local entries — useful for CI overrides.
#
# Values below match the Postgres in docker-compose.yml, published on 5433.

SCRIBA_TEST_DB_HOST=localhost
SCRIBA_TEST_DB_PORT=5433
SCRIBA_TEST_DB_NAME=scriba_test
SCRIBA_TEST_DB_USER=postgres
SCRIBA_TEST_DB_PASS=postgres
