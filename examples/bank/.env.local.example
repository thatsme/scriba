# Bank demo Postgres config. Copy to .env.local and customize.
# Values below match the Postgres in the repository-root
# docker-compose.yml, published on 5433 — adjust for your environment.
#
# Only the read model needs Postgres. The Commanded event store uses
# the InMemory adapter, which has no persistence and no setup. See
# README.md "Persistent event store" for the upgrade path.

BANK_DEMO_DB_HOST=localhost
BANK_DEMO_DB_PORT=5433
BANK_DEMO_DB_NAME=bank_demo
BANK_DEMO_DB_USER=postgres
BANK_DEMO_DB_PASS=postgres
